<UserControl x:Class="PlcHmi.Features.Plc.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:PlcHmi.Controls">

    <!-- 「采集点位」页：左扫描结果、右点位表，中间分隔条可拖动调宽 -->

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- 扫描结果与采集点位表左右并列：默认 40% / 60%，中间的分隔条可拖动调宽 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="6*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <hc:Card Grid.Row="0" Grid.ColumnSpan="3" Padding="16,12" Margin="0,0,0,12"
                 Background="{DynamicResource App.Surface}">
            <WrapPanel VerticalAlignment="Center">
                <controls:SectionHeader Title="扫描寄存器" Margin="0,0,12,0" />
                <TextBox hc:InfoElement.Title="起始地址" hc:InfoElement.TitlePlacement="Left" Width="160"
                         Text="{Binding ScanStart, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox hc:InfoElement.Title="结束地址" hc:InfoElement.TitlePlacement="Left" Width="160"
                         Margin="8,0,0,0" Text="{Binding ScanEnd, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox hc:InfoElement.Title="每段个数" hc:InfoElement.TitlePlacement="Left" Width="130"
                         Margin="8,0,0,0" Text="{Binding ScanBatchSize, UpdateSourceTrigger=PropertyChanged}" />
                <Rectangle Style="{StaticResource Divider}" />
                <Button Content="开始扫描" Command="{Binding ScanCommand}" Style="{StaticResource ButtonPrimary}"
                        Width="88" />
                <Button Content="取消扫描" Command="{Binding CancelScanCommand}" Width="88" Margin="8,0,0,0" />
                <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource SectionHint}" />
            </WrapPanel>
        </hc:Card>

        <hc:Card Grid.Row="1" Grid.Column="0" Padding="16,12" Margin="0,0,4,12"
                 Background="{DynamicResource App.Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 标题一行、按钮一行：窄窗口下 WrapPanel 自动换行，不会溢出去压隔壁卡片 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:SectionHeader Grid.Row="0" Title="扫描结果"
                                            Hint="地址可填 40001 这类人读地址；32/64 位量需先勾选加入点位表，再在右侧合并（扫描仅识别 16 位寄存器，无法判断哪两个寄存器构成一个浮点）" />
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="全选可读" Command="{Binding SelectAllReadableCommand}" Width="88" />
                        <Button Content="加入点位表" Command="{Binding AddSelectedScanResultsCommand}"
                                Style="{StaticResource ButtonSuccess}" Width="100" Margin="8,0,0,0" />
                    </WrapPanel>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding ScanResults}" Style="{StaticResource FlatGrid}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="选用" Width="60"
                                                Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="人读地址" Width="130" IsReadOnly="True"
                                            Binding="{Binding DisplayAddress}"
                                            ElementStyle="{StaticResource CellMono}" />
                        <DataGridTextColumn Header="协议地址" Width="110" IsReadOnly="True"
                                            Binding="{Binding Address}"
                                            ElementStyle="{StaticResource CellNumber}" />
                        <DataGridTextColumn Header="原始值" Width="120" IsReadOnly="True"
                                            Binding="{Binding RawText}"
                                            ElementStyle="{StaticResource CellNumber}" />
                        <DataGridTemplateColumn Header="状态" Width="*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}">
                                        <TextBlock.Style>
                                            <!-- 读异常标红，可读标绿 -->
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource App.Danger}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReadable}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource App.Success.Text}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </hc:Card>

        <!-- 拖动分隔条调整左右宽度（4* / 6* 只是初始比例） -->
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="8" Margin="0,0,4,12"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource App.Border}" />

        <hc:Card Grid.Row="1" Grid.Column="2" Padding="16,12" Margin="4,0,0,12"
                 Background="{DynamicResource App.Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 同样标题一行、按钮一行：提示长 + 三个按钮，挤一行会溢到左边那张卡片上 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:SectionHeader Grid.Row="0" Title="采集点位表"
                                            Hint="双击可编辑；选中相邻几行可【合并为点位】（类型定宽度、字序定顺序）；同一个寄存器只算一个点位，被压住的那些不采集、表里也不出列"
                                            Accent="{DynamicResource App.Success}" />
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <ComboBox Width="130" hc:InfoElement.Title="合并为" hc:InfoElement.TitlePlacement="Left"
                                  ItemsSource="{Binding MergeDataTypeOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="Value" SelectedValue="{Binding MergeDataType}" />
                        <ComboBox Width="160" Margin="8,0,0,0" hc:InfoElement.Title="字序"
                                  hc:InfoElement.TitlePlacement="Left"
                                  ItemsSource="{Binding WordOrderOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="Value" SelectedValue="{Binding MergeWordOrder}" />
                        <Button Content="合并为点位" Width="100" Margin="8,0,0,0"
                                Command="{Binding MergeSelectedTagsCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=TagGrid}" />
                        <Button Content="拆开多寄存器" Width="110" Margin="8,0,0,0"
                                Command="{Binding SplitSelectedTagsCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=TagGrid}" />
                        <Button Content="删除选中" Width="88" Margin="8,0,0,0"
                                Command="{Binding RemoveSelectedTagCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=TagGrid}" />
                        <Button Content="保存配置" Command="{Binding SaveConfigCommand}" Width="88"
                                Margin="8,0,0,0" />
                    </WrapPanel>
                </Grid>
                <DataGrid x:Name="TagGrid" Grid.Row="1" ItemsSource="{Binding TagConfigs}"
                          Style="{StaticResource FlatGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="人读地址" Width="150" IsReadOnly="True"
                                            Binding="{Binding DisplayAddress}"
                                            ElementStyle="{StaticResource CellMono}" />
                        <!-- 寄存器被别的点位占了就当场标红：改宽点位（16→32 位）最容易压住后面的点位 -->
                        <DataGridTemplateColumn Header="占用" Width="130" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OverlapText}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <!-- 不冲突时这一格空着，不占视觉 -->
                                                    <DataTrigger Binding="{Binding HasOverlap}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="协议地址" Width="110" Binding="{Binding Address}"
                                            ElementStyle="{StaticResource CellNumber}" />
                        <!-- 类型 / 字序用常驻下拉框（列设只读，单击即可改），改完点位占几个寄存器立刻跟着变；
                             被别的点位压住时禁用，免得继续把冲突改大 -->
                        <DataGridTemplateColumn Header="类型" Width="150" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.DataTypeOptions,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DisplayMemberPath="Display" SelectedValuePath="Value"
                                              IsEnabled="{Binding CanEditType}"
                                              SelectedValue="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 字序只对占多个寄存器的量有意义：16 位量只有一个寄存器，没有先后可言 -->
                        <DataGridTemplateColumn Header="字序" Width="170" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="—" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource App.Text.Secondary}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMultiRegister}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ComboBox ItemsSource="{Binding DataContext.WordOrderOptions,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  IsEnabled="{Binding CanEditType}"
                                                  SelectedValue="{Binding WordOrder, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMultiRegister}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="名称" Width="140" Binding="{Binding Name}"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="单位" Width="90" Binding="{Binding Unit}"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Scale" Width="100" Binding="{Binding Scale}"
                                            ElementStyle="{StaticResource CellNumber}" />
                        <DataGridTextColumn Header="Offset" Width="100" Binding="{Binding Offset}"
                                            ElementStyle="{StaticResource CellNumber}" />
                        <DataGridTextColumn Header="宽表列名" Width="*" Binding="{Binding ColumnName}"
                                            ElementStyle="{StaticResource CellText}" />
                        <!-- 存储组：由点位占的整段落在哪个区段决定，这里只展示；要改就改「存储映射」页的区段 -->
                        <DataGridTextColumn Header="存储组" Width="120" IsReadOnly="True"
                                            Binding="{Binding GroupText}"
                                            ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </hc:Card>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding TagStatus}" Margin="4,0,0,0"
                   Foreground="{DynamicResource App.Text.Secondary}" />
    </Grid>
</UserControl>
