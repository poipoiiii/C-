<UserControl x:Class="PlcHmi.Features.Plc.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:PlcHmi.Controls">

    <!-- 「存储映射」页：上为存储组草稿，下为建表语句预览，中间分隔条可上下拖动 -->

    <Grid Margin="12">
        <!-- 组表与建表预览上下并列：默认 4:6，中间的分隔条可上下拖动调高 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" MinHeight="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6*" MinHeight="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <hc:Card Grid.Row="0" Padding="16,12" Margin="0,0,0,0"
                 Background="{DynamicResource App.Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <controls:SectionHeader Title="存储组"
                                            Hint="一个区段一张表：从起始地址起连续读 N 个寄存器，点位按地址自动归组" />
                    <Button Content="新增组" Command="{Binding AddGroupCommand}" Width="80" Margin="12,0,0,0" />
                    <Button Content="删除组" Command="{Binding RemoveGroupCommand}" Width="80" Margin="8,0,0,0" />
                    <Rectangle Style="{StaticResource Divider}" />
                    <Button Content="刷新表清单" Command="{Binding RefreshTablesCommand}" Width="100" />
                    <Button Content="建表 / 校验结构" Command="{Binding CreateTableCommand}"
                            Style="{StaticResource ButtonPrimary}" Width="130" Margin="8,0,0,0" />
                </WrapPanel>

                <DataGrid Grid.Row="1" x:Name="GroupGrid" Margin="0,12,0,0"
                          ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                          Style="{StaticResource FlatGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="组名" Width="140" Binding="{Binding Name}"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="起始地址" Width="110" Binding="{Binding StartAddress}"
                                            ElementStyle="{StaticResource CellNumber}" />
                        <DataGridTextColumn Header="寄存器数" Width="110" Binding="{Binding Count}"
                                            ElementStyle="{StaticResource CellNumber}" />
                        <DataGridTextColumn Header="区段（人读）" Width="170" IsReadOnly="True"
                                            Binding="{Binding DisplayRange}"
                                            ElementStyle="{StaticResource CellMono}" />
                        <!-- 附加列：这几列加不加由现场定，勾掉后建表与插入都不会带上它们 -->
                        <DataGridCheckBoxColumn Header="Id列" Width="56"
                                                Binding="{Binding UseIdentityColumn, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridCheckBoxColumn Header="时间戳列" Width="70"
                                                Binding="{Binding UseTimestampColumn, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridCheckBoxColumn Header="机台号列" Width="74"
                                                Binding="{Binding UseMachineNoColumn, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTemplateColumn Header="目标表" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="0,2" IsEditable="True"
                                              ItemsSource="{Binding DataContext.Tables, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="存储模式" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="0,2"
                                              ItemsSource="{Binding DataContext.ModeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              DisplayMemberPath="Display" SelectedValuePath="Mode"
                                              SelectedValue="{Binding Mode}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </hc:Card>

        <!-- 拖动分隔条调整「存储组」与「建表语句预览」的高度（4* / 6* 只是初始比例） -->
        <GridSplitter Grid.Row="1" Height="8" Margin="0,4,0,4"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource App.Border}" />

        <hc:Card Grid.Row="2" Padding="16,12"
                 Background="{DynamicResource App.Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <controls:SectionHeader Title="建表语句预览" />

                    <!-- 当前写入 / 最近一次建表结果都是长句子，各占一行换行显示：
                         挤在标题右边会横向溢出，右边那截根本看不全 -->
                    <TextBlock Margin="11,8,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Bold"
                               Text="{Binding EffectiveStorageText}"
                               Foreground="{DynamicResource App.Accent}" />
                    <TextBlock Margin="11,4,0,0" TextWrapping="Wrap" FontSize="12"
                               Text="{Binding StorageStatus}"
                               Foreground="{DynamicResource App.Warning}" />

                    <!-- 建表规则那一大段收进折叠项：常驻会把预览挤成一条缝 -->
                    <Expander Margin="0,8,0,0" Header="建表规则说明">
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource App.Text.Secondary}"
                                   Text="每个组一张表，点位按自己的「存储组」落到对应表。Id、时间戳、机台号属于「附加列」，按现场要求勾选：勾上就建列并写入，勾掉就完全不碰（机台号列用于一张表给多台机器用时区分数据来源）。所以插入时至少要留一样能写的列 —— 长表的寄存器列、宽表的点位列、或者任一附加列。表名与列名会先过标识符白名单（中英文/数字/下划线，不能数字开头），再用 [ ] 包裹执行，避免 SQL 注入。表不存在按下面语句创建；宽表已存在会自动补齐缺的列。组表是草稿，点【建表 / 校验结构】或【保存配置】才生效。" />
                    </Expander>
                </StackPanel>
                <TextBox Grid.Row="2" Text="{Binding CreateScriptPreview, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                         Padding="12" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="{DynamicResource App.Surface.Subtle}"
                         BorderBrush="{DynamicResource App.Border}" />
            </Grid>
        </hc:Card>

        <TextBlock Grid.Row="3" Text="{Binding Dashboard.RecordsInfo}" Margin="4,12,0,0"
                   Foreground="{DynamicResource App.Text.Secondary}" />
    </Grid>
</UserControl>
