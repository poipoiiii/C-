<Window x:Class="PlcHmi.Views.Dialogs.PlcConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PlcHmi.Controls"
        Title="PLC 连接配置" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource RegionBrush}">
    <!-- 连接参数集中在这里一次填完：顶栏只留摘要，不常驻一排输入框。
         高度按内容自适应：探测结果那行会换行，定高会被窗口裁掉 -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:SectionHeader Grid.Row="0" Title="PLC 通信配置"
                                Hint="连接参数跟着这台设备走，改完点【确定】生效" />

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC IP" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="IpBox" Height="32" Margin="0,0,0,12"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="端口" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortBox" Height="32" Margin="0,0,0,12"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="从站号" Style="{StaticResource FieldLabel}" />
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="探测从站" Width="92" Height="32" Margin="8,0,0,0"
                        IsEnabled="{Binding IsProbeIdle}" Click="Probe_Click"
                        ToolTip="按上面框里当前的 IP/端口探一遍，把探测到的从站号自动填进来" />
                <TextBox x:Name="SlaveIdBox" Height="32" VerticalContentAlignment="Center"
                         Text="{Binding SlaveIdText, Mode=OneWay}"
                         ToolTip="1~247；点【探测从站】可自动填充" />
            </DockPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="采集周期" Style="{StaticResource FieldLabel}" />
            <DockPanel Grid.Row="3" Grid.Column="1">
                <TextBlock DockPanel.Dock="Right" Text="ms/次" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource App.Text.Secondary}" />
                <TextBox x:Name="IntervalBox" Height="32" VerticalContentAlignment="Center" />
            </DockPanel>
        </Grid>

        <!-- 探测结果与从站号校验提示：有问题标红，一眼能看到为什么连不上 -->
        <TextBlock Grid.Row="2" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12"
                   Text="{Binding SlaveProbeStatus}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SlaveProbeFailed}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" VerticalAlignment="Center" Margin="0,0,12,0"
                       Visibility="Collapsed" Foreground="{DynamicResource App.Danger}" />
            <Button Content="确定" Width="88" Height="32" IsDefault="True" Click="Ok_Click"
                    Style="{StaticResource ButtonPrimary}" />
            <Button Content="取消" Width="88" Height="32" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
