<Window x:Class="PlcHmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:controls="clr-namespace:PlcHmi.Controls"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="PLC 采集监控看板" Height="900" Width="1400"
        WindowState="Maximized"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource RegionBrush}">

    <!-- 分区块、表格、状态块的样式统一放在 App.xaml：主窗口与各弹窗共用一套。
         界面里所有颜色都走 DynamicResource 引用 App.* 画刷，切亮/暗主题时整体跟着换 -->

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏：机台号 + 三个操作分区 + 状态，一行摆开 ==================== -->
        <hc:Card Grid.Row="0" Padding="16,12" Margin="0,0,0,12"
                 Background="{DynamicResource App.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- PLC 摘要长短不一，让它吃掉中间剩余宽度：窄窗口下先省略它，别去挤两边 -->
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左端：机台号大字。机型完全由它前 4 位决定（AIXP999 → AIXP），不给手工选；
                     点大字就地修改，改已有值要过密码（见 PasswordWindow），免得现场随手一改顺手把机型也换了 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="机台号" FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource App.Text.Secondary}" />
                    <Grid>
                        <TextBlock x:Name="MachineNoText" Text="{Binding MachineNoText}" FontSize="32"
                                   FontWeight="Bold" FontFamily="Consolas" Cursor="Hand"
                                   MouseLeftButtonUp="MachineNoText_Click"
                                   ToolTip="{Binding MachineNoTooltip}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
                                    <Style.Triggers>
                                        <!-- 没填或认不出机型：标黄提醒，但照旧用当前机型的配置跑 -->
                                        <DataTrigger Binding="{Binding HasMachineNoProblem}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource App.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- 点大字后换成它：回车保存、Esc 取消、失焦也保存 -->
                        <TextBox x:Name="MachineNoEditor" Width="230" Height="46" FontSize="32"
                                 FontWeight="Bold" FontFamily="Consolas" MaxLength="64"
                                 VerticalContentAlignment="Center" Visibility="Collapsed"
                                 KeyDown="MachineNoEditor_KeyDown" LostFocus="MachineNoEditor_LostFocus"
                                 ToolTip="回车保存，Esc 取消（小写会自动转成大写）" />
                    </Grid>
                </StackPanel>

                <!-- 分区一：PLC 通信参数。输入项收进弹窗，这里只留摘要 + 一个【配置】 -->
                <Border Grid.Column="1" Style="{StaticResource ZoneBox}" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="PLC 通信" FontSize="12"
                                   Foreground="{DynamicResource App.Text.Secondary}" />
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PlcConfigSummary}" FontSize="16" FontWeight="SemiBold"
                                       FontFamily="Consolas" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource App.Text.Primary}" />
                            <Button Grid.Column="1" Content="配置…" Width="76" Height="34" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Click="ConfigurePlc_Click"
                                    ToolTip="一次填写 IP / 端口 / 从站号 / 采集周期" />
                        </Grid>

                        <!-- 从站没配好：说明为什么右三个开关点不动（不出现时整行收起，不占高度） -->
                        <TextBlock Grid.Row="2" Margin="0,6,0,0" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SlaveProbeStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SlaveProbeFailed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="从站未配置成功：" />
                            <Run Text="{Binding SlaveProbeStatus}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 分区二：连接（连 / 断 PLC 链路）。从站没配好就不给点 -->
                <Border Grid.Column="2" Style="{StaticResource ZoneBox}" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="连接" FontSize="12"
                                   Foreground="{DynamicResource App.Text.Secondary}" />
                        <!-- ToggleGesture 必须显式写 LeftClick：ToggleBlock 靠内部的 MouseBinding 触发，
                             默认手势是 None，不写就点不动；Padding/Height 也要自己给 -->
                        <hc:ToggleBlock IsChecked="{Binding ConnectionSwitch}" Width="96" Height="34"
                                        Padding="14,0" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        IsEnabled="{Binding CanToggleConnection}"
                                        ToggleGesture="LeftClick" ToolTipService.ShowOnDisabled="True"
                                        CheckedContent="断开" UnCheckedContent="连接"
                                        ToolTip="连接 / 断开 PLC 链路">
                            <hc:ToggleBlock.Style>
                                <Style TargetType="hc:ToggleBlock" BasedOn="{StaticResource {x:Type hc:ToggleBlock}}">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="{DynamicResource App.Accent}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource App.Neutral}" />
                                        </Trigger>
                                        <!-- ToggleBlock 不是按钮，禁用时不会自己变灰，这里手动变淡 -->
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                            <Setter Property="ToolTip" Value="从站未配置成功：先点【配置…】探测到从站" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:ToggleBlock.Style>
                        </hc:ToggleBlock>
                    </StackPanel>
                </Border>

                <!-- 分区三：采集（开始/停止 与 是否落库）。
                     三个开关都是"实心胶囊 + 白字"：之前那个 Background=Transparent 的落库开关
                     看着像一行纯文字，跟旁边两个胶囊不是一路 -->
                <Border Grid.Column="3" Style="{StaticResource ZoneBox}" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="数据采集" FontSize="12"
                                   Foreground="{DynamicResource App.Text.Secondary}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <hc:ToggleBlock IsChecked="{Binding AcquisitionSwitch}" Width="104" Height="34"
                                            Padding="14,0" VerticalAlignment="Center"
                                            IsEnabled="{Binding CanToggleAcquisition}"
                                            ToggleGesture="LeftClick" ToolTipService.ShowOnDisabled="True"
                                            CheckedContent="停止采集" UnCheckedContent="开始采集"
                                            ToolTip="开始 / 停止采集（只停数据采集，连接保持不变）">
                                <hc:ToggleBlock.Style>
                                    <Style TargetType="hc:ToggleBlock" BasedOn="{StaticResource {x:Type hc:ToggleBlock}}">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="{DynamicResource App.Success}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource App.Warning}" />
                                            </Trigger>
                                            <!-- ToggleBlock 不是按钮，禁用时不会自己变灰，这里手动变淡 -->
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Setter Property="ToolTip" Value="从站配好并连上之后才能开始采集" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:ToggleBlock.Style>
                            </hc:ToggleBlock>

                            <hc:ToggleBlock IsChecked="{Binding PersistEnabled}" Height="34" Padding="14,0"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            IsEnabled="{Binding CanTogglePersist}"
                                            ToggleGesture="LeftClick" ToolTipService.ShowOnDisabled="True"
                                            CheckedContent="写入数据库" UnCheckedContent="不落库"
                                            ToolTip="采集到的数据是否写入数据库">
                                <hc:ToggleBlock.Style>
                                    <Style TargetType="hc:ToggleBlock" BasedOn="{StaticResource {x:Type hc:ToggleBlock}}">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="{DynamicResource App.Neutral}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource App.Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Setter Property="ToolTip" Value="从站未配置成功：先点【配置…】探测到从站" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:ToggleBlock.Style>
                            </hc:ToggleBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 右端：状态圆点 + 状态文字。连接/从站/采集出错时标红提醒 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource App.Off}" />
                                <Style.Triggers>
                                    <!-- 连上且没通信错误 → 绿 -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsConnected}" Value="True" />
                                            <Condition Binding="{Binding HasCommError}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="{DynamicResource App.Success}" />
                                    </MultiDataTrigger>
                                    <!-- 连上但有通信错误 → 红 -->
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource App.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold"
                               MaxWidth="420" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource App.Text.Regular}" />
                                <Style.Triggers>
                                    <!-- 连接/从站/采集出错：标红提醒，别让人以为只是没点开始 -->
                                    <DataTrigger Binding="{Binding HasCommError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </hc:Card>

        <!-- ==================== 页签：下划线胶囊式表头 ==================== -->
        <TabControl Grid.Row="1" FontSize="14" Style="{StaticResource PillTabControl}">

            <!-- ==================== 实时看板 ==================== -->
            <!-- 每个页签的 DataContext 指向自己的视图模型；外壳（连接/机型/状态栏）留在 Window.DataContext -->
            <TabItem Header="实时看板" DataContext="{Binding Dashboard}">
                <ScrollViewer x:Name="CardScroll" Margin="12" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"
                              SizeChanged="CardScroll_SizeChanged">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 一个存储组一段：点组头可收起 / 展开，收起状态存在视图模型里 -->
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,4">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource App.Text.Primary}" />
                                                <TextBlock Text="{Binding HeaderText}" Style="{StaticResource SectionHint}" />
                                            </StackPanel>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <!-- 列数按卡片区实际宽度算出来，均分宽度才能真正排满整行 -->
                                                    <UniformGrid Columns="{Binding CardColumns,
                                                                RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <hc:Card Height="292" Margin="0,0,12,12" Padding="16"
                                                             BorderThickness="1"
                                                             Background="{DynamicResource App.Surface}"
                                                             BorderBrush="{DynamicResource App.Border}">
                                                        <Grid ClipToBounds="True">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <!-- 离线卡片整体淡化，一眼看出哪台没数据 -->
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>

                                                            <Grid Grid.Row="0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                                             Margin="0,0,8,0">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Fill"
                                                                                        Value="{DynamicResource App.Off}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                                        <Setter Property="Fill"
                                                                                                Value="{DynamicResource App.Success}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                    <TextBlock Text="{Binding Tag.Name}" FontSize="15" FontWeight="Bold"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource App.Text.Primary}" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Tag.DisplayAddress}" HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center" FontSize="12" FontFamily="Consolas"
                                                                           Foreground="{DynamicResource App.Text.Faint}" />
                                                            </Grid>

                                                            <Grid Grid.Row="1" Margin="0,10,0,6">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                                    <TextBlock Text="{Binding ValueText}" FontSize="34" FontWeight="Bold"
                                                                               FontFamily="Consolas" Foreground="{Binding AccentBrush}" />
                                                                    <TextBlock Text="{Binding Tag.Unit}" FontSize="14" Margin="6,0,0,6"
                                                                               VerticalAlignment="Bottom"
                                                                               Foreground="{DynamicResource App.Text.Secondary}" />
                                                                </StackPanel>
                                                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                            Margin="0,0,0,4">
                                                                    <TextBlock HorizontalAlignment="Right" FontSize="12">
                                                                        <Run Text="原始值 "
                                                                             Foreground="{DynamicResource App.Text.Faint}" />
                                                                        <Run Text="{Binding RawText}" FontWeight="SemiBold"
                                                                             Foreground="{DynamicResource App.Text.Regular}" />
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding UpdatedAtText}" HorizontalAlignment="Right"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource App.Text.Faint}" />
                                                                    <TextBlock Text="{Binding FailureText}" HorizontalAlignment="Right"
                                                                               FontSize="11" MaxWidth="260"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource App.Danger}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <!-- 正常时没有失败原因，整行收起 -->
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding FailureText}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- 点曲线弹出这张表的历史记录；用 Preview 事件，免得被图表自己的鼠标处理吃掉 -->
                                                            <lvc:CartesianChart Grid.Row="2"
                                                                                ToolTip="点击查看这张表的历史记录"
                                                                                PreviewMouseLeftButtonUp="Chart_Click"
                                                                                Series="{Binding Series}"
                                                                                XAxes="{Binding XAxes}"
                                                                                YAxes="{Binding YAxes}"
                                                                                LegendPosition="Hidden"
                                                                                TooltipPosition="Hidden" />
                                                        </Grid>
                                                    </hc:Card>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 采集点位 ==================== -->
            <TabItem Header="采集点位" DataContext="{Binding Scan}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 扫描结果与采集点位表左右并列：默认 40% / 60%，中间的分隔条可拖动调宽 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" MinWidth="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <hc:Card Grid.Row="0" Grid.ColumnSpan="3" Padding="16,12" Margin="0,0,0,12"
                             Background="{DynamicResource App.Surface}">
                        <WrapPanel VerticalAlignment="Center">
                            <controls:SectionHeader Title="扫描寄存器" Margin="0,0,12,0" />
                            <TextBox hc:InfoElement.Title="起始地址" hc:InfoElement.TitlePlacement="Left" Width="160"
                                     Text="{Binding ScanStart, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox hc:InfoElement.Title="结束地址" hc:InfoElement.TitlePlacement="Left" Width="160"
                                     Margin="8,0,0,0" Text="{Binding ScanEnd, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox hc:InfoElement.Title="每段个数" hc:InfoElement.TitlePlacement="Left" Width="130"
                                     Margin="8,0,0,0" Text="{Binding ScanBatchSize, UpdateSourceTrigger=PropertyChanged}" />
                            <Rectangle Style="{StaticResource Divider}" />
                            <Button Content="开始扫描" Command="{Binding ScanCommand}" Style="{StaticResource ButtonPrimary}"
                                    Width="88" />
                            <Button Content="取消扫描" Command="{Binding CancelScanCommand}" Width="88" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource SectionHint}" />
                        </WrapPanel>
                    </hc:Card>

                    <hc:Card Grid.Row="1" Grid.Column="0" Padding="16,12" Margin="0,0,4,12"
                             Background="{DynamicResource App.Surface}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <controls:SectionHeader Title="扫描结果"
                                                        Hint="地址可填 40001 这种人读地址；" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="全选可读" Command="{Binding SelectAllReadableCommand}" Width="88" />
                                    <Button Content="加入点位表" Command="{Binding AddSelectedScanResultsCommand}"
                                            Style="{StaticResource ButtonSuccess}" Width="100" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ScanResults}" Style="{StaticResource FlatGrid}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="选用" Width="60"
                                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="人读地址" Width="130" IsReadOnly="True"
                                                        Binding="{Binding DisplayAddress}"
                                                        ElementStyle="{StaticResource CellMono}" />
                                    <DataGridTextColumn Header="协议地址" Width="110" IsReadOnly="True"
                                                        Binding="{Binding Address}"
                                                        ElementStyle="{StaticResource CellNumber}" />
                                    <DataGridTextColumn Header="原始值" Width="120" IsReadOnly="True"
                                                        Binding="{Binding RawText}"
                                                        ElementStyle="{StaticResource CellNumber}" />
                                    <DataGridTemplateColumn Header="状态" Width="*" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}">
                                                    <TextBlock.Style>
                                                        <!-- 读异常标红，可读标绿 -->
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource App.Danger}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReadable}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource App.Success.Text}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </hc:Card>

                    <!-- 拖动分隔条调整左右宽度（4* / 6* 只是初始比例） -->
                    <GridSplitter Grid.Row="1" Grid.Column="1" Width="8" Margin="0,0,4,12"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  Background="{DynamicResource App.Border}" />

                    <hc:Card Grid.Row="1" Grid.Column="2" Padding="16,12" Margin="4,0,0,12"
                             Background="{DynamicResource App.Surface}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <controls:SectionHeader Title="采集点位表"
                                                        Hint="双击可编辑；宽表列名默认跟随名称自动同步，单独改过之后就不再跟着变"
                                                        Accent="{DynamicResource App.Success}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="删除选中" Width="88"
                                            Command="{Binding RemoveSelectedTagCommand}"
                                            CommandParameter="{Binding SelectedItems, ElementName=TagGrid}" />
                                    <Button Content="保存配置" Command="{Binding SaveConfigCommand}" Width="88"
                                            Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="TagGrid" Grid.Row="1" ItemsSource="{Binding TagConfigs}"
                                      Style="{StaticResource FlatGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="人读地址" Width="130" IsReadOnly="True"
                                                        Binding="{Binding DisplayAddress}"
                                                        ElementStyle="{StaticResource CellMono}" />
                                    <DataGridTextColumn Header="协议地址" Width="110" Binding="{Binding Address}"
                                                        ElementStyle="{StaticResource CellNumber}" />
                                    <DataGridTextColumn Header="名称" Width="140" Binding="{Binding Name}"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="单位" Width="90" Binding="{Binding Unit}"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Scale" Width="100" Binding="{Binding Scale}"
                                                        ElementStyle="{StaticResource CellNumber}" />
                                    <DataGridTextColumn Header="Offset" Width="100" Binding="{Binding Offset}"
                                                        ElementStyle="{StaticResource CellNumber}" />
                                    <DataGridTextColumn Header="宽表列名" Width="*" Binding="{Binding ColumnName}"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <!-- 存储组：由地址落在哪个区段决定，这里只展示；要改就改「存储映射」页的区段 -->
                                    <DataGridTextColumn Header="存储组" Width="120" IsReadOnly="True"
                                                        Binding="{Binding GroupText}"
                                                        ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </hc:Card>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding TagStatus}" Margin="4,0,0,0"
                               Foreground="{DynamicResource App.Text.Secondary}" />
                </Grid>
            </TabItem>

            <!-- ==================== 存储映射 ==================== -->
            <TabItem Header="存储映射" DataContext="{Binding Storage}">
                <Grid Margin="12">
                    <!-- 组表与建表预览上下并列：默认 4:6，中间的分隔条可上下拖动调高 -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*" MinHeight="180" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6*" MinHeight="150" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <hc:Card Grid.Row="0" Padding="16,12" Margin="0,0,0,0"
                             Background="{DynamicResource App.Surface}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                <controls:SectionHeader Title="存储组"
                                                        Hint="一个区段一张表：从起始地址起连续读 N 个寄存器，点位按地址自动归组" />
                                <Button Content="新增组" Command="{Binding AddGroupCommand}" Width="80" Margin="12,0,0,0" />
                                <Button Content="删除组" Command="{Binding RemoveGroupCommand}" Width="80" Margin="8,0,0,0" />
                                <Rectangle Style="{StaticResource Divider}" />
                                <Button Content="刷新表清单" Command="{Binding RefreshTablesCommand}" Width="100" />
                                <Button Content="建表 / 校验结构" Command="{Binding CreateTableCommand}"
                                        Style="{StaticResource ButtonPrimary}" Width="130" Margin="8,0,0,0" />
                            </WrapPanel>

                            <DataGrid Grid.Row="1" x:Name="GroupGrid" Margin="0,12,0,0"
                                      ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                                      Style="{StaticResource FlatGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="组名" Width="140" Binding="{Binding Name}"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="起始地址" Width="110" Binding="{Binding StartAddress}"
                                                        ElementStyle="{StaticResource CellNumber}" />
                                    <DataGridTextColumn Header="寄存器数" Width="110" Binding="{Binding Count}"
                                                        ElementStyle="{StaticResource CellNumber}" />
                                    <DataGridTextColumn Header="区段（人读）" Width="170" IsReadOnly="True"
                                                        Binding="{Binding DisplayRange}"
                                                        ElementStyle="{StaticResource CellMono}" />
                                    <!-- 附加列：这两列加不加由现场定，勾掉后建表与插入都不会带上它们 -->
                                    <DataGridCheckBoxColumn Header="Id列" Width="56"
                                                            Binding="{Binding UseIdentityColumn, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridCheckBoxColumn Header="时间戳列" Width="70"
                                                            Binding="{Binding UseTimestampColumn, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTemplateColumn Header="目标表" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Margin="0,2" IsEditable="True"
                                                          ItemsSource="{Binding DataContext.Tables, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="存储模式" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Margin="0,2"
                                                          ItemsSource="{Binding DataContext.ModeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Mode"
                                                          SelectedValue="{Binding Mode}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </hc:Card>

                    <!-- 拖动分隔条调整「存储组」与「建表语句预览」的高度（4* / 6* 只是初始比例） -->
                    <GridSplitter Grid.Row="1" Height="8" Margin="0,4,0,4"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="{DynamicResource App.Border}" />

                    <hc:Card Grid.Row="2" Padding="16,12"
                             Background="{DynamicResource App.Surface}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <controls:SectionHeader Title="建表语句预览" />

                                <!-- 当前写入 / 最近一次建表结果都是长句子，各占一行换行显示：
                                     挤在标题右边会横向溢出，右边那截根本看不全 -->
                                <TextBlock Margin="11,8,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Bold"
                                           Text="{Binding EffectiveStorageText}"
                                           Foreground="{DynamicResource App.Accent}" />
                                <TextBlock Margin="11,4,0,0" TextWrapping="Wrap" FontSize="12"
                                           Text="{Binding StorageStatus}"
                                           Foreground="{DynamicResource App.Warning}" />

                                <!-- 建表规则那一大段收进折叠项：常驻会把预览挤成一条缝 -->
                                <Expander Margin="0,8,0,0" Header="建表规则说明">
                                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource App.Text.Secondary}"
                                               Text="每个组一张表，点位按自己的「存储组」落到对应表。Id 与时间戳属于「附加列」，按现场要求勾掉就不要（插入时也不会写它们，所以长表的寄存器列、宽表的点位列至少要留一样）。表名与列名会先过标识符白名单（中英文/数字/下划线，不能数字开头），再用 [ ] 包裹执行，避免 SQL 注入。表不存在按下面语句创建；宽表已存在会自动补齐缺的列。组表是草稿，点【建表 / 校验结构】或【保存配置】才生效。" />
                                </Expander>
                            </StackPanel>
                            <TextBox Grid.Row="2" Text="{Binding CreateScriptPreview, Mode=OneWay}" IsReadOnly="True"
                                     AcceptsReturn="True" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                                     Padding="12" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Background="{DynamicResource App.Surface.Subtle}"
                                     BorderBrush="{DynamicResource App.Border}" />
                        </Grid>
                    </hc:Card>

                    <TextBlock Grid.Row="3" Text="{Binding Dashboard.RecordsInfo}" Margin="4,12,0,0"
                               Foreground="{DynamicResource App.Text.Secondary}" />
                </Grid>
            </TabItem>
            <!-- ==================== 触发记录 ==================== -->
            <TabItem Header="触发记录" DataContext="{Binding Trigger}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <hc:Card Grid.Row="0" Padding="16,12" Margin="0,0,0,12"
                             Background="{DynamicResource App.Surface}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                <controls:SectionHeader Title="触发规则"
                                                        Hint="PLC 置信号 1 → 记一条记录 → 上位机写应答 1 → PLC 清信号 → 上位机写应答 0" />
                                <TextBox hc:InfoElement.Title="轮询间隔(ms)" hc:InfoElement.TitlePlacement="Left"
                                         Width="160" Margin="12,0,0,0"
                                         Text="{Binding TriggerPollIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="新增规则" Command="{Binding AddTriggerRuleCommand}" Width="88"
                                        Margin="8,0,0,0" />
                                <Button Content="删除选中" Width="88" Margin="8,0,0,0"
                                        Command="{Binding RemoveTriggerRuleCommand}"
                                        CommandParameter="{Binding SelectedItems, ElementName=TriggerGrid}" />
                                <Button Content="保存配置" Command="{Binding SaveTriggerRulesCommand}" Width="88"
                                        Margin="8,0,0,0" />
                            </WrapPanel>

                            <DataGrid Grid.Row="1" x:Name="TriggerGrid" Height="180" Margin="0,12,0,0"
                                      ItemsSource="{Binding Triggers}" SelectedItem="{Binding SelectedTrigger}"
                                      Style="{StaticResource FlatGrid}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="启用" Width="60"
                                                            Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="规则名" Width="140" Binding="{Binding Name}"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="信号地址" Width="100" Binding="{Binding SignalAddress}"
                                                        ElementStyle="{StaticResource CellNumber}" />
                                    <DataGridTextColumn Header="应答地址" Width="100" Binding="{Binding AckAddress}"
                                                        ElementStyle="{StaticResource CellNumber}" />
                                    <DataGridTextColumn Header="信号(人读)" Width="110" IsReadOnly="True"
                                                        Binding="{Binding DisplaySignal}"
                                                        ElementStyle="{StaticResource CellMono}" />
                                    <DataGridTextColumn Header="应答(人读)" Width="110" IsReadOnly="True"
                                                        Binding="{Binding DisplayAck}"
                                                        ElementStyle="{StaticResource CellMono}" />
                                    <DataGridTextColumn Header="超时(ms)" Width="100" Binding="{Binding TimeoutMs}"
                                                        ElementStyle="{StaticResource CellNumber}" />
                                    <DataGridTextColumn Header="状态" Width="*" IsReadOnly="True"
                                                        Binding="{Binding StatusText}"
                                                        ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </hc:Card>

                    <hc:Card Grid.Row="1" Padding="16,12" Background="{DynamicResource App.Surface}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <controls:SectionHeader Title="最近触发记录"
                                                        Hint="{Binding TriggerRecordsInfo}"
                                                        Accent="{DynamicResource App.Warning}" />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource App.Text.Secondary}"
                                           Text="只记「事件发生过」：时间戳 + 规则名 + 信号/应答地址。机台号、批次号、卷号这类业务字段由后续处理写入这张表即可。" />
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding TriggerView}" AutoGenerateColumns="True"
                                      IsReadOnly="True" Style="{StaticResource FlatGrid}"
                                      ColumnHeaderStyle="{StaticResource FlatHeader}" />
                        </Grid>
                    </hc:Card>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,12,0,0">
                        <TextBlock Text="{Binding TriggerStatus}"
                                   Foreground="{DynamicResource App.Text.Secondary}" />
                        <TextBlock Text="{Binding TriggerAlarm}" Margin="16,0,0,0"
                                   Foreground="{DynamicResource App.Danger}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ==================== 状态栏 ==================== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 四个提示块形状一律走 StatusChip，只有底色按语义不同 -->
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <Border Background="{DynamicResource App.Accent.Soft}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProfileStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ProfileStatus}"
                               Foreground="{DynamicResource App.Accent}" />
                </Border>
                <!-- 机台号已挪到左上角大字展示；这里只留配置文件路径、状态与告警 -->
                <Border Background="{DynamicResource App.Surface.Hover}" Style="{StaticResource StatusChip}">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource App.Text.Regular}" />
                </Border>
                <Border Background="{DynamicResource App.Danger.Soft}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CommError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding CommError}"
                               Foreground="{DynamicResource App.Danger}" />
                </Border>
                <Border Background="{DynamicResource App.Warning.Soft}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PersistError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding PersistError}"
                               Foreground="{DynamicResource App.Warning}" />
                </Border>
            </WrapPanel>

            <!-- 亮/暗切换：控制室夜班常开暗色，选择记在本机档案里 -->
            <hc:ToggleBlock Grid.Column="1" IsChecked="{Binding IsDarkTheme}" Width="104" Height="30"
                            Padding="14,0" VerticalAlignment="Center" ToggleGesture="LeftClick"
                            CheckedContent="暗色主题" UnCheckedContent="亮色主题"
                            ToolTip="切换亮色 / 暗色界面">
                <hc:ToggleBlock.Style>
                    <Style TargetType="hc:ToggleBlock" BasedOn="{StaticResource {x:Type hc:ToggleBlock}}">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource App.Text.Primary}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </hc:ToggleBlock.Style>
            </hc:ToggleBlock>
        </Grid>
    </Grid>
</Window>
