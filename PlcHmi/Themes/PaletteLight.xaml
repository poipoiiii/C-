<!--
    亮色配色（跟 PaletteDark.xaml 一一对应，只换颜色值，键名不动）。

    分两段：
    1) 覆盖 HandyControl 的调色板 —— HC 默认主色是 #326CF3，与本应用强调色 #409EFF 是"两种蓝"，
       这里把主色/强调色/标题色/四个语义色统一成一套 Element 风格配色。
       这两个字典在 App.xaml 里排在 HC 皮肤与 Theme.xaml 之后，所以同一份 Color 键以这里为准。
    2) 本应用自己的画刷（App.*）—— 界面里所有颜色都引用它们，切主题时整套换。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 1. 覆盖 HandyControl 调色板 ==================== -->
    <Color x:Key="PrimaryColor">#FF409EFF</Color>
    <Color x:Key="DarkPrimaryColor">#FF337ECC</Color>
    <Color x:Key="AccentColor">#FF409EFF</Color>
    <Color x:Key="DarkAccentColor">#FF337ECC</Color>
    <Color x:Key="TitleColor">#FF409EFF</Color>
    <Color x:Key="SecondaryTitleColor">#FF409EFF</Color>

    <Color x:Key="SuccessColor">#FF67C23A</Color>
    <Color x:Key="DarkSuccessColor">#FF529B2E</Color>
    <Color x:Key="WarningColor">#FFE6A23C</Color>
    <Color x:Key="DarkWarningColor">#FFC98A28</Color>
    <Color x:Key="DangerColor">#FFF56C6C</Color>
    <Color x:Key="DarkDangerColor">#FFD95B5B</Color>
    <Color x:Key="InfoColor">#FF909399</Color>
    <Color x:Key="DarkInfoColor">#FF7A7D84</Color>

    <!-- ==================== 2. 本应用配色 ==================== -->
    <!-- 文字：从主到次四级 -->
    <SolidColorBrush x:Key="App.Text.Primary" Color="#FF303133" />
    <SolidColorBrush x:Key="App.Text.Regular" Color="#FF606266" />
    <SolidColorBrush x:Key="App.Text.Secondary" Color="#FF909399" />
    <SolidColorBrush x:Key="App.Text.Faint" Color="#FFA8ABB2" />

    <!-- 面：卡片 / 分区浅底 / hover / 斑马 -->
    <SolidColorBrush x:Key="App.Surface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="App.Surface.Subtle" Color="#FFFAFBFC" />
    <SolidColorBrush x:Key="App.Surface.Hover" Color="#FFF4F4F5" />

    <!-- 线 -->
    <SolidColorBrush x:Key="App.Border" Color="#FFEBEEF5" />
    <SolidColorBrush x:Key="App.Border.Light" Color="#FFF0F2F5" />

    <!-- 语义色 + 对应浅底 -->
    <SolidColorBrush x:Key="App.Accent" Color="#FF409EFF" />
    <SolidColorBrush x:Key="App.Accent.Soft" Color="#FFECF5FF" />
    <SolidColorBrush x:Key="App.Success" Color="#FF67C23A" />
    <SolidColorBrush x:Key="App.Success.Text" Color="#FF529B2E" />
    <SolidColorBrush x:Key="App.Warning" Color="#FFE6A23C" />
    <SolidColorBrush x:Key="App.Warning.Soft" Color="#FFFDF6EC" />
    <SolidColorBrush x:Key="App.Danger" Color="#FFF56C6C" />
    <SolidColorBrush x:Key="App.Danger.Soft" Color="#FFFEF0F0" />
    <SolidColorBrush x:Key="App.Neutral" Color="#FF909399" />

    <!-- 离线/未激活的点、禁用块 -->
    <SolidColorBrush x:Key="App.Off" Color="#FFC0C4CC" />
</ResourceDictionary>
