<!--
    暗色配色：键名与 PaletteLight.xaml 完全一致，只换值。
    控制室常开夜班，暗底更护眼；语义色保持同一支色相（蓝/绿/橙/红），只把浅底压暗、文字提亮。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 1. 覆盖 HandyControl 调色板（语义色与亮色一致） ==================== -->
    <Color x:Key="PrimaryColor">#FF409EFF</Color>
    <Color x:Key="DarkPrimaryColor">#FF337ECC</Color>
    <Color x:Key="AccentColor">#FF409EFF</Color>
    <Color x:Key="DarkAccentColor">#FF337ECC</Color>
    <Color x:Key="TitleColor">#FF409EFF</Color>
    <Color x:Key="SecondaryTitleColor">#FF409EFF</Color>

    <Color x:Key="SuccessColor">#FF67C23A</Color>
    <Color x:Key="DarkSuccessColor">#FF529B2E</Color>
    <Color x:Key="WarningColor">#FFE6A23C</Color>
    <Color x:Key="DarkWarningColor">#FFC98A28</Color>
    <Color x:Key="DangerColor">#FFF56C6C</Color>
    <Color x:Key="DarkDangerColor">#FFD95B5B</Color>
    <Color x:Key="InfoColor">#FF909399</Color>
    <Color x:Key="DarkInfoColor">#FF7A7D84</Color>

    <!-- ==================== 2. 本应用配色 ==================== -->
    <SolidColorBrush x:Key="App.Text.Primary" Color="#FFE5EAF3" />
    <SolidColorBrush x:Key="App.Text.Regular" Color="#FFCFD3DC" />
    <SolidColorBrush x:Key="App.Text.Secondary" Color="#FFA3A6AD" />
    <SolidColorBrush x:Key="App.Text.Faint" Color="#FF7C7F86" />

    <!-- 卡片比页面底(#1C1C1C)略亮一档，暗底上才分得清层次 -->
    <SolidColorBrush x:Key="App.Surface" Color="#FF232529" />
    <SolidColorBrush x:Key="App.Surface.Subtle" Color="#FF1F2124" />
    <SolidColorBrush x:Key="App.Surface.Hover" Color="#FF2B2E34" />

    <SolidColorBrush x:Key="App.Border" Color="#FF3A3D43" />
    <SolidColorBrush x:Key="App.Border.Light" Color="#FF303339" />

    <SolidColorBrush x:Key="App.Accent" Color="#FF409EFF" />
    <SolidColorBrush x:Key="App.Accent.Soft" Color="#FF1B3A5C" />
    <SolidColorBrush x:Key="App.Success" Color="#FF67C23A" />
    <SolidColorBrush x:Key="App.Success.Text" Color="#FF85CE61" />
    <SolidColorBrush x:Key="App.Warning" Color="#FFE6A23C" />
    <SolidColorBrush x:Key="App.Warning.Soft" Color="#FF3A2F1E" />
    <SolidColorBrush x:Key="App.Danger" Color="#FFF56C6C" />
    <SolidColorBrush x:Key="App.Danger.Soft" Color="#FF3A2226" />
    <SolidColorBrush x:Key="App.Neutral" Color="#FF909399" />

    <SolidColorBrush x:Key="App.Off" Color="#FF5A5D63" />
</ResourceDictionary>
